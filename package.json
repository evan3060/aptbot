{
  "name": "aptbot",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsc && node scripts/build-webui.mjs",
    "dev": "tsx --env-file=.env src/server.ts",
    "webui:build": "node scripts/build-webui.mjs",
    "webui:watch": "node scripts/build-webui.mjs --watch",
    "webui:dev": "vite --config src/webui-react/vite.config.ts"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.2",
    "@types/node": "^26.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.3",
    "happy-dom": "^20.10.6",
    "ink-testing-library": "^4.0.0",
    "tailwindcss": "^4.3.2",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vite": "^8.1.3",
    "vitest": "^4.1.9"
  },
  "dependencies": {
    "async-mutex": "^0.5.0",
    "gray-matter": "^4.0.3",
    "ink": "^7.1.0",
    "lit": "^3.3.3",
    "lucide-react": "^1.23.0",
    "marked": "^15.0.12",
    "motion": "^12.42.2",
    "pino": "^10.3.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "ws": "^8.21.0",
    "zod": "^4.4.3"
  }
}
